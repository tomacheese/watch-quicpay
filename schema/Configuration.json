{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
        "discord": {
            "anyOf": [
                {
                    "properties": {
                        "channel_id": {
                            "description": "Webhook と併用する Discord チャンネル ID (任意)",
                            "type": "string"
                        },
                        "token": {
                            "description": "Webhook と併用する Discord Bot の token (任意)",
                            "type": "string"
                        },
                        "webhook_url": {
                            "description": "空でない Discord Webhook URL (Bot より優先)",
                            "minLength": 1,
                            "type": "string"
                        }
                    },
                    "required": [
                        "webhook_url"
                    ],
                    "type": "object"
                },
                {
                    "properties": {
                        "channel_id": {
                            "description": "空でない Discord チャンネル ID",
                            "minLength": 1,
                            "type": "string"
                        },
                        "token": {
                            "description": "空でない Discord Bot の token",
                            "minLength": 1,
                            "type": "string"
                        },
                        "webhook_url": {
                            "description": "Discord Webhook URL (指定時は空文字列不可)",
                            "minLength": 1,
                            "type": "string"
                        }
                    },
                    "required": [
                        "channel_id",
                        "token"
                    ],
                    "type": "object"
                }
            ],
            "description": "Discord の通知先設定 (Webhook または Bot)"
        }
    },
    "required": [
        "discord"
    ],
    "type": "object"
}

